<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules: excludes the encrypted database for the same reason as backup_rules.xml. -->
<!-- (Comments in this file were written by AI - Claude.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="stickdeck.db" />
        <exclude domain="database" path="stickdeck.db-wal" />
        <exclude domain="database" path="stickdeck.db-shm" />
        <exclude domain="database" path="stickdeck.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="stickdeck.db" />
        <exclude domain="database" path="stickdeck.db-wal" />
        <exclude domain="database" path="stickdeck.db-shm" />
        <exclude domain="database" path="stickdeck.db-journal" />
    </device-transfer>
</data-extraction-rules>
