    <string name="tut_title">How to play</string>
    <string name="tut_skip">Skip</string>
    <string name="tut_next">Next</string>
    <string name="tut_done">Let\'s play</string>
    <string name="tut_deck_title">Build your deck</string>
    <string name="tut_deck_body">A deck has 7 slots for sticks and power-ups, plus one Trainer who gives you a bonus. Better sticks (C, U, R, SR, UR) hit harder and last longer.</string>
    <string name="tut_rounds_title">Fight in rounds</string>
    <string name="tut_rounds_body">Each round you have 7 seconds to pick a move. If time runs out you rest. Bring your opponent from 1000 HP to 0 to win.</string>
    <string name="tut_moves_title">Know your moves</string>
    <string name="tut_moves_body">Jab is fast, Lunge hits hardest, Slash is in between, Parry blocks and strikes back, Rest restores stamina. Attacks wear your stick down; switch sticks for free before you act.</string>
    <string name="tut_items_title">Use power-ups</string>
    <string name="tut_items_body">A power-up takes your whole turn. A Lighter sets a stick on fire, Water puts it out but slows it. Use them on yourself or your opponent.</string>
    <string name="tut_collect_title">Grow your collection</string>
    <string name="tut_collect_body">Win coins in battles and from your daily bonus. Buy Common, Rare and Ultra Rare packs any time, and single cards in the weekly card store.</string>
    <string name="tut_friends_title">Duel your friends</string>
    <string name="tut_friends_body">On the same Wi-Fi, one player hosts and the other picks the game from the list. Each stakes 1 to 3 sticks; the winner keeps them all.</string>

